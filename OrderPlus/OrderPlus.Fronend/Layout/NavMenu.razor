@inject IStringLocalizer<Resource> _Localizer


    
    <div class="nav-item logo-container">
     <MudImage Src="images/Order_plus.png" alt="Logo" Class="rounded" Style="width: 220px; height: 150px; margin-right: 10px;margin-left: 10px;" />
    </div>
    <br />
    <MudNavMenu>
<MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">@_Localizer["Home"]</MudNavLink>
    <MudNavLink Href="/about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">@_Localizer["About"]</MudNavLink> 
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="/banks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalance">@_Localizer["Banks"]</MudNavLink>
            <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">@_Localizer["Categories"]</MudNavLink>
            <MudNavLink Href="/purchases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingBag">@_Localizer["purchase"]</MudNavLink>
            <MudNavLink Href="/inventories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Rule">@_Localizer["Inventories"]</MudNavLink>
            <MudNavLink Href="/news" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Newspaper">@_Localizer["News and Promotions"]</MudNavLink>
            <MudNavLink Href="/countries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public">@_Localizer["Country"]</MudNavLink>
            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">@_Localizer["Orders"]</MudNavLink>
            <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">@_Localizer["Products"]</MudNavLink>
            <MudNavLink Href="/suppliers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalShipping">@_Localizer["Suppliers"]</MudNavLink>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">@_Localizer["Users"]</MudNavLink>
            <MudNavGroup Title="@_Localizer["Reports"]" Icon="@Icons.Material.Filled.Summarize">
                <MudNavLink Href="/report_InventoryAdjustment" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">@_Localizer["Inventory Adjustments"]</MudNavLink>
                <MudNavLink Href="/report_InventoryValuation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">@_Localizer["Inventory valuation"]</MudNavLink>
                <MudNavLink Href="/report_GrossProfit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">@_Localizer["Gross Profit"]</MudNavLink>
            </MudNavGroup>
        </Authorized>
     </AuthorizeView>
    <AuthorizeView Roles="User">
        <Authorized>
            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">@_Localizer["My Orders"]</MudNavLink>
        </Authorized>
    </AuthorizeView>       
</MudNavMenu>