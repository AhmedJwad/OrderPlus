@inject IStringLocalizer<Resource> _Localizer


    
    <div class="nav-item logo-container">
     <MudImage Src="images/Order_plus.png" alt="Logo" Class="rounded" Style="width: 220px; height: 150px; margin-right: 10px;margin-left: 10px;" />
    </div>
    <br />
    <MudNavMenu>
<MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Home">@_Localizer["Home"]</MudNavLink>
    <MudNavLink Href="/about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">@_Localizer["About"]</MudNavLink> 
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavLink Href="/banks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalance">Banks</MudNavLink>
            <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categories</MudNavLink>
            <MudNavLink Href="/purchases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingBag">Compras</MudNavLink>
            <MudNavLink Href="/inventories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Rule">Inventarios</MudNavLink>
            <MudNavLink Href="/news" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Newspaper">Noticias & Promociones</MudNavLink>
            <MudNavLink Href="/countries" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public">Country</MudNavLink>
            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">Orders</MudNavLink>
            <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">Products</MudNavLink>
            <MudNavLink Href="/suppliers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.LocalShipping">Suppliers</MudNavLink>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">Users</MudNavLink>
            <MudNavGroup Title="Reports" Icon="@Icons.Material.Filled.Summarize">
                <MudNavLink Href="/report_InventoryAdjustment" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">Inventory Adjustments</MudNavLink>
                <MudNavLink Href="/report_InventoryValuation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">Inventory valuation</MudNavLink>
                <MudNavLink Href="/report_GrossProfit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">Gross Profit</MudNavLink>
            </MudNavGroup>
        </Authorized>
     </AuthorizeView>
    <AuthorizeView Roles="User">
        <Authorized>
            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">My Orders</MudNavLink>
        </Authorized>
    </AuthorizeView>       
</MudNavMenu>