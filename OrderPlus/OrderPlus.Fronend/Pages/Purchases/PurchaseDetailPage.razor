﻿@if (loading)
{
    <Loading />
}
else
{
    <MudDialog>
        <DialogContent>
            <div class="row p-2">
                <div class="col-6">
                    <div class="mb-3">
                        <label>Date:</label>
                        <div>
                            <b>@Purchase!.Date</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Provider:</label>
                        <div>
                            <b>@Purchase.Supplier!.SupplierName</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Contact:</label>
                        <div>
                            <b>@Purchase.Supplier!.ContactFullName</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Telephone:</label>
                        <div>
                            <b>@Purchase.Supplier!.Phone</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Email:</label>
                        <div>
                            <b>@Purchase.Supplier!.Email</b>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <label>Purchase Count:</label>
                        <div>
                            <b>@($"{Purchase.Lines:N0}")</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Value:</label>
                        <div>
                            <b>@($"{Purchase.Quantity:N2}")</b>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Value:</label>
                        <div>
                            <b>@($"{Purchase.Value:N2}")</b>
                        </div>
                    </div>
                </div>
            </div>
            <MudTable Items="@PurchaseDetails"
                      @ref="table"
                      ServerData="@(new Func<TableState, Task<TableData<PurchaseDetail>>>(LoadListAsync))"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      FixedHeader="true"
                      FixedFooter="true">
                <ToolBarContent>
                    <div class="d-flex justify-content-between">
                        <MudText Typo="Typo.h6" Class="me-4"><i class="bi bi-bag"></i> Detalle Compra</MudText>
                    </div>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Product</MudTh>
                    <MudTh>Commit</MudTh>
                    <MudTh>Cost</MudTh>
                    <MudTh>Quantity</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Product">@(TruncateContent(context.Name!, 25))</MudTd>
                    <MudTd DataLabel="Commit">@(TruncateContent(context.Remarks!, 25))</MudTd>
                    <MudTd DataLabel="Cost">@($"{context.Cost:N0}")</MudTd>
                    <MudTd DataLabel="Quantity">@($"{context.Quantity:N2}")</MudTd>
                    <MudTd DataLabel="Value">@($"{context.Value:c2}")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No records found.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Number of Records:"
                                   PageSizeOptions="pageSizeOptions"
                                   AllItemsText="Todos"
                                   InfoFormat="@infoFormat" />
                </PagerContent>
            </MudTable>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" Href="/purchases" Class="p-2">
               Return
            </MudButton>
        </DialogActions>
    </MudDialog>
}