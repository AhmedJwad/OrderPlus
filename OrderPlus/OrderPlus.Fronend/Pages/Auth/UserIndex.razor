@page "/users"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Users"
              @ref="table"
              ServerData="@(new Func<TableState, Task<TableData<User>>>(LoadListAsync))"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4"><i class="bi bi-people"></i> Users</MudText>
                <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.Add" Color="Color.Info" Href="/register/?IsAdmin=true">Adicionar Administrador</MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Image</MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Address</MudTh>
            <MudTh>Confirmed</MudTh>
            <MudTh>User Type</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Image">
                <img src="https://localhost:7106/@context.Photo" width="80" height="80" style="border-radius:50%" />
            </MudTd>
            <MudTd DataLabel="Full Name">@context.FullName</MudTd>          
            <MudTd DataLabel="Telephone">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Address">@context.Address, @context.City!.Name, @context.City!.State!.Name, @context.City!.State!.Country!.Name</MudTd>
            <MudTd DataLabel="Confirmation">@context.EmailConfirmed</MudTd>
            <MudTd DataLabel="user Type">@EnumHelper.GetEnumDescription(context.UserType)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No records found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Number of Records:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}