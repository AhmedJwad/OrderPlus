﻿<MudDialog>   
    <DialogContent>
        <MudText Typo="Typo.h5">Are you sure you want to log out?</MudText>
        <MudText Typo="Typo.body2">If you log out, you will need to log back in to access your account.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="CancelAction">Cancel</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LogoutActionAsync">Log Out</MudButton>
    </DialogActions>
</MudDialog>