@page "/api/accounts/ConfirmEmail"

<MudPaper Class="confirmation-container p-4 shadow-sm">
    <MudGrid>
        <MudItem xs="12" Class="text-center mb-4">
            <MudText Typo="Typo.h3">Confirmation</MudText>
        </MudItem>
        <MudItem xs="12" Class="text-center mb-4">
            <MudText Typo="Typo.body1">Press the button to confirm your account</MudText>
        </MudItem>
        <MudItem xs="12" Class="text-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmAccountAsync">Confirm Account</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>