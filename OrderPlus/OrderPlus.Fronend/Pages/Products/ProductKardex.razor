
﻿@if (loading)
{
    <Loading />
}
else
{
    <MudDialog>
        <DialogContent>
            <MudTable Items="@Kardex"
                      @ref="table"
                      ServerData="@(new Func<TableState, Task<TableData<Kardex>>>(LoadListAsync))"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      FixedHeader="true"
                      FixedFooter="true">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Movement Type</MudTh>
                    <MudTh>Cost</MudTh>
                    <MudTh>Amount</MudTh>
                    <MudTh>Balance</MudTh>
                    <MudTh>Average Cost</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.Date.ToLocalTime()</MudTd>
                    <MudTd DataLabel="Movement Type">@EnumHelper.GetEnumDescription(context.KardexType)</MudTd>
                    <MudTd DataLabel="Cost">@($"{context.Cost:C2}")</MudTd>
                    <MudTd DataLabel="Amount">@($"{context.Quantity:N2}")</MudTd>
                    <MudTd DataLabel="Balance">@($"{context.Balance:N2}")</MudTd>
                    <MudTd DataLabel="Average Cost">@($"{context.AverageCost:C2}")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No records found.</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Number of Records:"
                                   PageSizeOptions="pageSizeOptions"
                                   AllItemsText="Todos"
                                   InfoFormat="@infoFormat" />
                </PagerContent>
            </MudTable>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" Href="/products" Class="p-2">
               Return
            </MudButton>
        </DialogActions>
    </MudDialog>
}