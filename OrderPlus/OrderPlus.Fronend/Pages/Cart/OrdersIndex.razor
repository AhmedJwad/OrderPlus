@page "/orders"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Orders"
              @ref="table"
              ServerData="@(new Func<TableState, Task<TableData<Order>>>(LoadListAsync))"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4"><i class="bi bi-currency-dollar"></i> Orders</MudText>
            </div>
            <MudSpacer />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>User</MudTh>
            <MudTh>Comment</MudTh>
            <MudTh>State</MudTh>
            <MudTh>Pay</MudTh>
            <MudTh>Lines</MudTh>
            <MudTh>Amountd</MudTh>
            <MudTh>Value</MudTh>
            <MudTh style="width: 150px;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@($"{context.Date.ToLocalTime():yyyy/MM/dd hh:mm tt}")</MudTd>
            <MudTd DataLabel="User">@context.User!.FullName</MudTd>
            <MudTd DataLabel="Comment">@context.Remarks</MudTd>
            <MudTd DataLabel="State">@EnumHelper.GetEnumDescription(context.OrderStatus)</MudTd>
            <MudTd DataLabel="Pay">@EnumHelper.GetEnumDescription(context.OrderType)</MudTd>
            <MudTd DataLabel="Lines">@($"{context.Lines:N0}")</MudTd>
            <MudTd DataLabel="Amount">@($"{context.Quantity:N2}")</MudTd>
            <MudTd DataLabel="Value">@($"{context.Value:C2}")</MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.Info" Color="Color.Warning" Href=@($"/cart/orderDetails/{context.Id}")>Details</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No records found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Number of Records:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}