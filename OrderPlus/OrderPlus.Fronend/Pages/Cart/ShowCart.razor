@page "/Cart/ShowCart"

<MudCard>
    <div class="p-2">
        <MudItem>
            <MudText Typo="Typo.h5"><i class="bi bi-bag"></i> Shopping Cart</MudText>
        </MudItem>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudCardContent>
                    <EditForm Model="OrderDTO" OnValidSubmit="ConfirmOrderAsync">
                        <DataAnnotationsValidator />
                        <MudTextField Label="Comments"
                                      @bind-Value="@OrderDTO.Remarks"
                                      For="@(() => OrderDTO.Remarks)"
                                      Lines="3"
                                      Class="mb-4" />
                        <MudText Typo="Typo.h5">Quantity products: <strong>@($"{sumQuantity:N2}")</strong></MudText>
                        <MudText Typo="Typo.h5">Value: <strong>@($"{sumValue:C2}")</strong></MudText>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" ButtonType="ButtonType.Submit" class="my-3">
                            Confirm Order
                        </MudButton>
                    </EditForm>
                </MudCardContent>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCardContent>
                    <div style="display: flex; align-items: center;">
                        <div style="flex: 1;">
                            <MudRadioGroup T="int" @bind-Value="selectedPaymeontOption">
                                <MudRadio T="int" Value=0>Cash on delivery</MudRadio>
                                <MudRadio T="int" Value=1>PSE payment</MudRadio>
                            </MudRadioGroup>
                        </div>
                        <div style="text-align: center;">
                            <MudImage Src="/images/PSE.png" Alt="PSE" Width="180" />
                        </div>
                    </div>
                    @if (selectedPaymeontOption == 1)
                    {
                        <MudAutocomplete T="Bank"
                                         Label="Banco"
                                         Placeholder="--Select a bank--"
                                         SearchFunc="SearchBankAsync"
                                         Value="selectedBank"
                                         ValueChanged="BankChanged"
                                         ToStringFunc="@(e=> e==null?null : $"{e.Name}")">
                            <ItemTemplate Context="itemContext">
                                @itemContext.Name
                            </ItemTemplate>
                        </MudAutocomplete>
                        <MudTextField Label="Email"
                                      @bind-Value="@email"
                                      Class="mb-4" />
                    }
                </MudCardContent>
            </MudItem>
        </MudGrid>

        @if(loading)
        {
            <Loading Label="Checking online payment approval...." />
        }

        <MudTable Items="@TemporalOrders"
                  @ref="table"
                  ServerData="@(new Func<TableState, Task<TableData<TemporalOrder>>>(LoadListAsync))"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  FixedHeader="true"
                  FixedFooter="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Quantity</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Value</MudTh>
                <MudTh>Comments</MudTh>
                <MudTh>Image</MudTh>
                <MudTh style="width: 270px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Product!.Name</MudTd>
                <MudTd DataLabel="Description">@context.Product!.Description</MudTd>
                <MudTd DataLabel="Quantity">
                    <div style="display: flex; align-items: center;">
                        <!-- Decrease Button -->
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => DecreaseQuantity(context.Id))"
                                   Disabled="@(context.Quantity <= 1)">                           
                            <MudIcon Icon="@Icons.Material.Filled.Remove" />
                        </MudButton>

                        <!-- Quantity Display -->
                        <span style="margin: 0 8px;">@($"{context.Quantity:N2}")</span>

                        <!-- Increase Button -->
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => IncreaseQuantity(context.Id))">
                            <MudIcon Icon="@Icons.Material.Filled.Add" />
                        </MudButton>
                    </div>
                </MudTd>                              
                <MudTd DataLabel="Price">@($"{context.Product!.Price:C2}")</MudTd>
                <MudTd DataLabel="Value">@($"{context.Value:C2}")</MudTd>
                <MudTd DataLabel="Comments">@context.Remarks</MudTd>
                <MudTd DataLabel="image">
                    <img src="https://localhost:7106/@context.Product!.MainImage" alt="Image Principal" style="max-width: 100px; max-height: 100px;" />
                </MudTd>
                <MudTd DataLabel="Actions">                   
                    <MudButton Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick=@(() => DeleteAsync(@context.Id))>Delete</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No orders found.</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
</MudCard>