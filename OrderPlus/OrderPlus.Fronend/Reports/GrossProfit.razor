@page "/report_GrossProfit"

@if (loading)
{
    <Loading />
}
else
{
    <MudCard>
        <div class="p-2">
            <MudItem>
                <MudText Typo="Typo.h5"><i class="bi bi-currency-dollar"></i> Gross Profit</MudText>
            </MudItem>
            <MudGrid>
                <MudItem xs="4">
                    <MudDatePicker Label="Start date" Date="@initialDate" DateChanged="OnInitialDateChange" />
                </MudItem>
                <MudItem xs="4">
                    <MudDatePicker Label="End date" Date="@finalDate" DateChanged="OnFinalDateChange" />
                </MudItem>
                <MudItem xs="4" class="d-flex justify-content-end align-items-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="GenerateReportAsync">
                        Generate Report
                    </MudButton>
                </MudItem>
            </MudGrid>
        </div>
    </MudCard>
    @if (showReport)
    {
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h4">Gross Profit</MudText>
                <MudTable Items="reports" Dense="true" Hover="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>User</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Product</MudTh>
                        <MudTh style="text-align: right;">Cost</MudTh>
                        <MudTh style="text-align: right;">Quantity</MudTh>
                        <MudTh style="text-align: right;">Value</MudTh>
                        <MudTh style="text-align: right;">Profit</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@($"{context.Date:yyyy/MM/dd}")</MudTd>
                        <MudTd DataLabel="User">@context.User!.FullName</MudTd>
                        <MudTd DataLabel="Status">@EnumHelper.GetEnumDescription(context.OrderStatus)</MudTd>
                        <MudTd DataLabel="Type">@EnumHelper.GetEnumDescription(context.OrderType)</MudTd>
                        <MudTd DataLabel="Product">@context.Name</MudTd>
                        <MudTd DataLabel="Cost" style="text-align: right;">@($"{context.Product!.Cost:C2}")</MudTd>
                        <MudTd DataLabel="Quantity" style="text-align: right;">@($"{context.Quantity:N2}")</MudTd>
                        <MudTd DataLabel="Value" style="text-align: right;">@($"{context.Value:C2}")</MudTd>
                        <MudTd DataLabel="Profit" style="text-align: right;">@($"{context.Profit:C2}")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTh><b>Total</b></MudTh>
                        <MudTh style="text-align: right;"></MudTh>
                        <MudTh style="text-align: right;"></MudTh>
                        <MudTh style="text-align: right;"></MudTh>
                        <MudTh style="text-align: right;"></MudTh>
                        <MudTh style="text-align: right;"></MudTh>
                        <MudTh style="text-align: right;"><b>@($"{totalQuantity:N2}")</b></MudTh>
                        <MudTh style="text-align: right;"><b>@($"{totalValue:C2}")</b></MudTh>
                        <MudTh style="text-align: right;"><b>@($"{totalProfit:C2}")</b></MudTh>
                    </FooterContent>
                </MudTable>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportToExcel" Class="m-3">
                    Export to Excel
                </MudButton>
            </MudCardContent>
        </MudCard>
    }
}